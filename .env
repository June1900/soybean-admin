# 应用的基础路径，默认为 "/"
# 若部署在子目录下，必须以 "/" 结尾，例如 "/admin/" 而非 "/admin"
VITE_BASE_URL=/

VITE_APP_TITLE=SoybeanAdmin

VITE_APP_DESC='SoybeanAdmin is a fresh and elegant admin template'

# 图标名称前缀
VITE_ICON_PREFIX=icon

# 本地 svg 图标组件前缀，必须包含 VITE_ICON_PREFIX
# 格式为 {VITE_ICON_PREFIX}-{本地图标名}
VITE_ICON_LOCAL_PREFIX=icon-local

# 路由权限模式：static（静态）｜ dynamic（动态）
# dynamic = 后端路由权限：调用 /api/v2/menu/getMenu 动态生成菜单与路由
VITE_AUTH_ROUTE_MODE=dynamic

# 静态路由权限模式下的首页
VITE_ROUTE_HOME=home

# 默认菜单图标
VITE_MENU_ICON=ri:menu-line

# 开发模式下是否启用 http 代理
VITE_HTTP_PROXY=Y

# vue-router 模式：hash | history | memory
VITE_ROUTER_HISTORY_MODE=history

# 后端服务成功码，收到该码即表示请求成功
VITE_SERVICE_SUCCESS_CODE=0000

# 后端登出码，收到该码会退出登录并跳转至登录页
VITE_SERVICE_LOGOUT_CODES=8888,8889

# 弹窗式登出码，收到该码会通过弹窗提示用户登出
VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778

# 令牌过期码，收到该码会刷新令牌并重新发送请求
VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333

# 静态路由模式下定义的超级管理员角色
VITE_STATIC_SUPER_ROLE=R_SUPER

# 是否生成 sourcemap
VITE_SOURCE_MAP=N

# 用于区分不同域名的存储前缀
VITE_STORAGE_PREFIX=SOY_

# 是否由程序自动检测更新
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# 是否在终端打印代理地址日志
VITE_PROXY_LOG=Y

# 是否自动启动编辑器
# 该插件仅在开发模式可用，构建模式下不可用
VITE_DEVTOOLS_LAUNCH_EDITOR=code

# 用于携带鉴权令牌的请求头名称
# 默认为 "Authorization"
VITE_TOKEN_HEADER_NAME=x-token
